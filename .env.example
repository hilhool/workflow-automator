# --- Telegram: аккаунт (чтение каналов и чатов) ---
# Получить на https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Telegram: бот (доставка сообщений тебе) ---
# Создать у @BotFather, затем написать боту /start — он ответит твоим id
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Необязательно: прокси для api.telegram.org, если Telegram закрыт провайдером.
# Формат: http://user:pass@host:port. Если пусто — берётся HTTPS_PROXY/HTTP_PROXY
# из окружения. Нужен именно здесь: aiohttp, в отличие от httpx, переменные
# окружения сам не читает.
TELEGRAM_PROXY=

# --- Claude CLI (используется твоя подписка, API-ключ не нужен) ---
CLAUDE_BIN=claude
CLAUDE_DEFAULT_MODEL=claude-sonnet-5
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
CLAUDE_TIMEOUT_SECONDS=300

# --- Веб-панель (только localhost) ---
WEB_HOST=127.0.0.1
WEB_PORT=8765

# --- Планировщик ---
TIMEZONE=Asia/Yekaterinburg
CATCH_UP_GRACE_MINUTES=720

LOG_LEVEL=INFO

# --- Moodle (расписание и задания) ---
# URL главной страницы, например https://moodle.university.ru
MOODLE_URL=
MOODLE_USERNAME=
MOODLE_PASSWORD=
# Необязательно: если знаешь готовый токен веб-сервиса, логин/пароль не нужны
MOODLE_TOKEN=
MOODLE_SERVICE=moodle_mobile_app

# --- Почта: сколько угодно ящиков, нумеруй по порядку ---
# Пароль нужен «для приложений», обычный пароль от аккаунта IMAP не примет.
# Сервер определяется по адресу автоматически (gmail, яндекс, mail.ru, outlook,
# icloud, rambler); для своего домена добавь MAIL_1_HOST.
MAIL_1_NAME=Личная
MAIL_1_EMAIL=
MAIL_1_PASSWORD=

MAIL_2_NAME=Учебная
MAIL_2_EMAIL=
MAIL_2_PASSWORD=
